#include <TFT_eSPI.h>

TFT_eSPI tft = TFT_eSPI();

void setup() {
  tft.init();
  tft.setRotation(1);

  // Fondo negro
  tft.fillScreen(TFT_BLACK);

  // ===== MARCOS =====
  tft.drawRect(5, 5, 310, 230, TFT_CYAN);
  tft.drawRect(10, 10, 300, 220, TFT_BLUE);
  tft.drawRect(15, 15, 290, 210, TFT_WHITE);

  // ===== DECORACIONES =====
  tft.fillCircle(25, 25, 6, TFT_RED);
  tft.fillCircle(295, 25, 6, TFT_GREEN);
  tft.fillCircle(25, 215, 6, TFT_YELLOW);
  tft.fillCircle(295, 215, 6, TFT_MAGENTA);

  // Líneas decorativas
  tft.drawFastHLine(40, 60, 240, TFT_DARKCYAN);
  tft.drawFastHLine(40, 190, 240, TFT_DARKCYAN);

  // ===== TEXTO =====
  tft.setTextDatum(MC_DATUM);

  // BIENVENIDOS
  tft.setTextColor(TFT_YELLOW, TFT_BLACK);
  tft.setTextSize(2);
  tft.drawString("BIENVENIDOS", tft.width()/2, 80);

  // ANTHONY
  tft.setTextColor(TFT_RED, TFT_BLACK);
  tft.setTextSize(3);
  tft.drawString("ANTHONY", tft.width()/2, 120);

  // BARBECHO
  tft.setTextColor(TFT_GREEN, TFT_BLACK);
  tft.setTextSize(3);
  tft.drawString("BARBECHO", tft.width()/2, 155);

  // ISAAC QUIZHPI
  tft.setTextColor(TFT_CYAN, TFT_BLACK);
  tft.setTextSize(2);
  tft.drawString("ISAAC QUIZHPI", tft.width()/2, 200);
}

void loop() {

}
